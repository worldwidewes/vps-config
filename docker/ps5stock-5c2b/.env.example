TRAEFIK_HOST=
TRAEFIK_SUBDOMAIN=

# How often to poll every source, in seconds.
CHECK_INTERVAL=

# HTTP timeout for each source request, in seconds.
REQUEST_TIMEOUT=

# --- Alerts (all optional; leave blank to disable) ---
# ntfy.sh (or self-hosted): topic name and optional full URL.
NTFY_URL=
NTFY_TOPIC=

# Discord webhook URL.
DISCORD_WEBHOOK=

# --- Optional official APIs (more reliable than scraping) ---
# Best Buy developer API key: https://developer.bestbuy.com
BESTBUY_API_KEY=
